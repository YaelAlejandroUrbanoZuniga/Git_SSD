# ── Database ────────────────────────────────────────────────────────────
# SQL Server connection string (Prisma format).
# The two real databases are MX_MFGIT_SSD_TEST (development/test) and
# MX_MFGIT_SSD (production). Never point a development .env at production.
# Local SQL Server with Windows integrated auth:
#   DATABASE_URL="sqlserver://localhost:1433;database=MX_MFGIT_SSD_TEST;integratedSecurity=true;trustServerCertificate=true"
# SQL auth:
#   DATABASE_URL="sqlserver://HOST:1433;database=MX_MFGIT_SSD_TEST;user=sa;password=YourPassword;trustServerCertificate=true"
# NOTE: TCP/IP must be enabled on the SQL Server instance (see backend/README.md).
DATABASE_URL="sqlserver://localhost:1433;database=MX_MFGIT_SSD_TEST;integratedSecurity=true;trustServerCertificate=true"

# ── Server ──────────────────────────────────────────────────────────────
# development | production — read by src/config/env.ts (defaults to development).
NODE_ENV=development
PORT=3000
# Comma-separated allowed origins for CORS (Vite dev server by default)
CORS_ORIGIN=http://localhost:5173

# ── Auth ────────────────────────────────────────────────────────────────
# JWT signing secret — CHANGE IN ANY REAL DEPLOYMENT.
# The server REFUSES TO START while this holds the literal placeholder below:
# it is public in the repository, so anyone could forge a token claiming the SSD
# (master) role. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-in-production
# Access token lifetime (seconds)
JWT_EXPIRES_IN=900
# Refresh token lifetime (days)
REFRESH_EXPIRES_DAYS=7

# ########################################################################
# # ⚠ THE TWO SETTINGS BELOW ARE THE MOST DANGEROUS IN THIS FILE.        #
# # Their values here are for LOCAL DEVELOPMENT ONLY, and they are also  #
# # the defaults the code falls back to when the variable is ABSENT — so #
# # an incomplete .env is just as unsafe as a wrong one. A deployment    #
# # copied from this file starts with simulated logins AND no mandatory  #
# # authentication. The server prints a loud startup banner in both      #
# # cases, but nothing stops it from running.                            #
# #                                                                      #
# # PRODUCTION MUST SET:   AUTH_MODE=ldap    AUTH_OPTIONAL=false         #
# ########################################################################

# AUTH_MODE=mock  -> LDAP validation is simulated (four fixed users, shared
#                    password "password"). Local dev without the FastAPI/LDAP service.
# AUTH_MODE=ldap  -> Node calls the external FastAPI/LDAP service.
# ⚠ ANY other value (or an absent variable) also selects the MOCK client.
# ⚠ PRODUCTION MUST BE: AUTH_MODE=ldap
AUTH_MODE=mock

# FastAPI/LDAP service (only used when AUTH_MODE=ldap)
LDAP_API_URL=http://localhost:8000
LDAP_API_KEY=dev-api-key

# AUTH_OPTIONAL=true  -> requests without a JWT are attributed to the demo user,
#                        who holds the SSD (master) role.
# AUTH_OPTIONAL=false -> every non-auth endpoint requires a valid Bearer token.
# ⚠ Only the exact string "false" disables it: "0", "no" and "FALSE " all mean true.
# ⚠ PRODUCTION MUST BE: AUTH_OPTIONAL=false
AUTH_OPTIONAL=true

# Role granted to a user on their FIRST login (least privilege). Must match a row
# in C_Role — the server verifies this at startup and refuses to boot otherwise.
DEFAULT_APP_ROLE=Guest
