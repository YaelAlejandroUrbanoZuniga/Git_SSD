# ── Database ────────────────────────────────────────────────────────────
# SQL Server connection string (Prisma format).
# Local SQL Server Express with Windows integrated auth:
#   DATABASE_URL="sqlserver://localhost:1433;database=ssd_pipeline;integratedSecurity=true;trustServerCertificate=true"
# SQL auth:
#   DATABASE_URL="sqlserver://HOST:1433;database=ssd_pipeline;user=sa;password=YourPassword;trustServerCertificate=true"
# NOTE: TCP/IP must be enabled on the SQL Server instance (see backend/README.md).
DATABASE_URL="sqlserver://localhost:1433;database=ssd_pipeline;integratedSecurity=true;trustServerCertificate=true"

# ── Server ──────────────────────────────────────────────────────────────
PORT=3000
# Comma-separated allowed origins for CORS (Vite dev server by default)
CORS_ORIGIN=http://localhost:5173

# ── Auth ────────────────────────────────────────────────────────────────
# JWT signing secret — CHANGE IN ANY REAL DEPLOYMENT
JWT_SECRET=change-me-in-production
# Access token lifetime (seconds)
JWT_EXPIRES_IN=900
# Refresh token lifetime (days)
REFRESH_EXPIRES_DAYS=7

# AUTH_MODE=mock  -> LDAP validation is simulated (any user in MOCK_USERS below,
#                    password "password"). Use for local dev without the FastAPI/LDAP service.
# AUTH_MODE=ldap  -> Node calls the external FastAPI/LDAP service.
AUTH_MODE=mock

# FastAPI/LDAP service (only used when AUTH_MODE=ldap)
LDAP_API_URL=http://localhost:8000
LDAP_API_KEY=dev-api-key

# AUTH_OPTIONAL=true  -> requests without a JWT are attributed to the demo user
#                        (keeps the un-migrated frontend fully functional).
# AUTH_OPTIONAL=false -> every non-auth endpoint requires a valid Bearer token.
AUTH_OPTIONAL=true
