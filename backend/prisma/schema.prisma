// ═══════════════════════════════════════════════════════════════════════
// Domain 6: System — users & notifications
// ═══════════════════════════════════════════════════════════════════════

model User {
  id          String    @id @default(cuid()) @map("PK_User") @db.NVarChar(50)
  username    String    @unique @map("Username") @db.NVarChar(100)
  displayName String    @map("DisplayName") @db.NVarChar(100)
  // Nullable + de-facto unique. A plain @unique on SQL Server tolerates only ONE
  // NULL per table, and email is null for any user without a corporate address,
  // so uniqueness (when not null) is enforced by a MANUAL filtered index
  // (WHERE Email IS NOT NULL) outside Prisma. Because Prisma doesn't know it's
  // unique, all email lookups in code use findFirst — never findUnique/upsert-by-email.
  email       String?   @map("Email") @db.NVarChar(200)
  // Active Directory objectGUID — populated on first LDAP login (the deployed
  // service doesn't return it yet, so it's null for every row today). NOT @unique
  // here for the same reason as email: SQL Server's plain UNIQUE allows a single
  // NULL, which would make the 2nd null-GUID INSERT fail with P2002. Real
  // uniqueness (when not null) lives in a MANUAL filtered index outside Prisma;
  // lookups by adObjectId therefore use findFirst, never findUnique.
  adObjectId  String?   @map("AdObjectId") @db.NVarChar(100)
  // Application role — FK to C_Role (default role assignment resolved in the
  // service layer; an FK can't carry a text default like "Buyer").
  roleId      Int       @map("FK_Role")
  role        Role      @relation(fields: [roleId], references: [id])
  createdAt   DateTime  @default(now()) @map("CreatedDt")
  lastLoginAt DateTime? @map("LastLoginDt")

  refreshTokens RefreshToken[]
  notifications Notification[]

  @@map("C_User")
}

model RefreshToken {
  id        String    @id @default(cuid()) @map("PK_User_RefreshToken") @db.NVarChar(50)
  tokenHash String    @unique @map("TokenHash") @db.NVarChar(128)
  userId    String    @map("FK_User") @db.NVarChar(50)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime  @map("ExpiresDt")
  revokedAt DateTime? @map("RevokedDt")
  createdAt DateTime  @default(now()) @map("CreatedDt")

  @@index([expiresAt], map: "IX_RefreshToken_ExpiresAt")
  @@map("T_User_RefreshToken")
}

model Notification {
  id        String   @id @map("PK_User_Notification") @db.NVarChar(50)
  message   String   @map("Message") @db.NVarChar(500)
  type      String   @map("Type") @db.NVarChar(20) // error | warning | info
  read      Boolean  @default(false) @map("Read")
  link      String?  @map("Link") @db.NVarChar(300)
  userId    String   @map("FK_User") @db.NVarChar(50)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Frontend displays a relative label ('hace 1h') — computed from createdAt
  createdAt DateTime @default(now()) @map("CreatedDt")

  @@index([userId, read], map: "IX_Notification_User_Read")
  @@map("T_User_Notification")
}

