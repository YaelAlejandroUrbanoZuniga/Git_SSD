// SSD Pipeline Management — Prisma schema (SQL Server)
//
// NOTES ON SQL SERVER LIMITATIONS (documented in README):
//  - Prisma does not support `enum` on the sqlserver provider → controlled
//    vocabularies (stage, role, sub-status, commodity…) are NVarChar columns
//    validated in the service layer (src/domain/constants.ts).
//  - Prisma does not support `Json` on sqlserver → tab-completion objects and
//    volume-by-year maps are flattened into scalar columns.
//  - Date-like display fields coming from the frontend contract are stored as
//    strings (some carry non-date values such as '2031' or 'hace 1h'); only
//    system timestamps use DateTime.
//
// NAMING: every model/field below carries @@map/@map to translate the
// Prisma-side (camelCase, English) names into Nexteer's real SQL Server
// naming standard (T_/C_ prefixed tables, PascalCase columns, PK_/FK_
// prefixes). Prisma Client's generated API is untouched — every field name
// used by backend/src/ stays exactly as-is; only the underlying column/table
// names change. See backend/README.md for the mapping rationale.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════════════════
// Domain 5 (lookup first so FKs can reference it): Commodity catalog
// ═══════════════════════════════════════════════════════════════════════

model Commodity {
  id              Int              @id @default(autoincrement()) @map("PK_Commodity")
  name            String           @unique @db.NVarChar(100) @map("Name")
  createdBy       String    @db.NVarChar(100) @map("CreatedBy")
  createdAt       DateTime  @default(now()) @map("CreatedDt")
  updatedBy       String?   @db.NVarChar(100) @map("UpdatedBy")
  updatedAt       DateTime? @map("UpdatedDt")
  suppliers       Supplier[]
  strategyEntries StrategyEntry[]
  mrlRequirements MrlRequirement[]

  @@map("C_Commodity")
}

// ═══════════════════════════════════════════════════════════════════════
// Domain 1: Supplier core
// ═══════════════════════════════════════════════════════════════════════

model Supplier {
  id     String @id @db.NVarChar(50) @map("PK_Supplier")
  folio  String @unique @db.NVarChar(50) @map("Folio")
  name   String @db.NVarChar(200) @map("Name")

  // Lifecycle: FK to C_SupplierStatus (ACTIVE | BLACKLISTED | COMPLETED)
  statusId          Int  @map("FK_SupplierStatus")
  status            SupplierStatus @relation(fields: [statusId], references: [id])
  // Current pipeline stage — FK to C_Stage
  stageId           Int  @map("FK_Stage")
  stage             Stage @relation(fields: [stageId], references: [id])
  // Origin stage captured only when the supplier exits to 'Blacklisted' or
  // 'Completed'; null while in any of the 5 active stages.
  stageBeforeExit   String? @db.NVarChar(50) @map("StageBeforeExit")

  scoutingPhase   String? @db.NVarChar(20) @map("ScoutingPhase") // Identified | B2B
  entrySource     String  @db.NVarChar(30) @map("EntrySource") // Scouting Event | Recommendation
  commodityId     Int     @map("FK_Commodity")
  commodity       Commodity @relation(fields: [commodityId], references: [id])
  productCategoryId Int  @map("FK_ProductCategory")
  productCategory   ProductCategory @relation(fields: [productCategoryId], references: [id])
  productType     String  @db.NVarChar(200) @map("ProductType")
  country         String  @db.NVarChar(100) @map("Country")
  manufacturingAddress String @db.NVarChar(300) @map("ManufacturingAddress")
  buyer           String  @db.NVarChar(100) @map("Buyer")
  scoutingInput   String  @db.NVarChar(200) @map("ScoutingInput")

  daysInStage         Int     @default(0) @map("DaysInStage")
  daysSinceParkingLot Int?    @map("DaysSinceParkingLot")
  docsPercent         Int     @default(0) @map("DocsPercent")
  slaId               Int  @map("FK_Sla")
  sla                 Sla @relation("SupplierSla", fields: [slaId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  globalSlaId         Int? @map("FK_GlobalSla")
  globalSla           Sla? @relation("SupplierGlobalSla", fields: [globalSlaId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  subStatusId         Int? @map("FK_SubStatus")
  subStatus           SubStatus? @relation(fields: [subStatusId], references: [id])
  onboardingDate      String  @db.NVarChar(30) @map("OnboardingDate")

  // Cross-stage evaluation summary (top-level fields in the frontend type)
  preEvalStartDate        String? @db.NVarChar(30) @map("PreEvalStartDate")
  initialQuoteSubmitted   Boolean @default(false) @map("InitialQuoteSubmitted")
  qadPrice                String? @db.NVarChar(50) @map("QadPrice")
  savingExpected          String? @db.NVarChar(50) @map("SavingExpected")
  tooling                 String? @db.NVarChar(50) @map("Tooling")
  selectedForDevelopment  Boolean @default(false) @map("SelectedForDevelopment")
  investigateRecordNumber String? @db.NVarChar(100) @map("InvestigateRecordNumber")
  intelexDate             String? @db.NVarChar(30) @map("IntelexDate")

  createdAt DateTime @default(now()) @map("CreatedDt")
  updatedAt DateTime @default(now()) @updatedAt @map("UpdatedDt")

  companyInfo    CompanyInfo?
  technicalInfo  TechnicalInfo?
  commercialInfo CommercialInfo?
  documents      SupplierDocument[]
  notes          SupplierNote[]
  history        SupplierHistoryEntry[]
  parts          SupplierPart[]
  prelimParts    PrelimPart[]

  scoutingData     ScoutingData?
  parkingData      ParkingData?
  preliminaryData  PreliminaryData?
  supplierEvalData SupplierEvalData?
  intelexData      IntelexData?

  blacklistEntry  BlacklistEntry?
  completionEntry CompletionEntry?

  eventEntries EventSupplierEntry[]
  b2bMeetings  EventB2BMeeting[]

  @@index([stageId, statusId], map: "IX_Supplier_Stage_Status")
  @@index([buyer], map: "IX_Supplier_Buyer")
  @@map("T_Supplier")
}

model CompanyInfo {
  supplierId      String  @id @db.NVarChar(50) @map("FK_Supplier")
  supplier        Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  fullName        String  @db.NVarChar(300) @map("FullName")
  dunsNumber      String  @db.NVarChar(50) @map("DunsNumber")
  taxIdNumber     String? @db.NVarChar(50) @map("TaxIdNumber")
  recommendedBy   String? @db.NVarChar(100) @map("RecommendedBy")
  recommenderDept String? @db.NVarChar(100) @map("RecommenderDept")
  companyType     String  @db.NVarChar(50) @map("CompanyType")
  foundedYear     Int     @map("FoundedYear")
  headquarters    String  @db.NVarChar(300) @map("Headquarters")
  website         String  @db.NVarChar(300) @map("Website")
  phone           String  @db.NVarChar(50) @map("Phone")
  contactEmail    String  @db.NVarChar(200) @map("ContactEmail")
  contactName     String  @db.NVarChar(100) @map("ContactName")

  @@index([dunsNumber], map: "IX_CompanyInfo_DunsNumber")
  @@map("T_Supplier_CompanyInfo")
}

model TechnicalInfo {
  supplierId              String  @id @db.NVarChar(50) @map("FK_Supplier")
  supplier                Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  technology              String  @db.NVarChar(200) @map("Technology")
  machineryType           String  @db.NVarChar(200) @map("MachineryType")
  processMethod           String  @db.NVarChar(200) @map("ProcessMethod")
  pressCapacity           String  @db.NVarChar(100) @map("PressCapacity")
  materials               String  @db.NVarChar(300) @map("Materials")
  complementaryOperations String? @db.NVarChar(300) @map("ComplementaryOperations")
  safetyCritical          Boolean @default(false) @map("SafetyCritical")
  safetyExperience        Boolean @default(false) @map("SafetyExperience")
  certifications          String  @db.NVarChar(300) @map("Certifications")
  knowsCQIs               Boolean @default(false) @map("KnowsCQIs")

  @@map("T_Supplier_TechnicalInfo")
}

model CommercialInfo {
  supplierId       String  @id @db.NVarChar(50) @map("FK_Supplier")
  supplier         Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  annualRevenue    String  @db.NVarChar(50) @map("AnnualRevenue")
  productionVolume String  @db.NVarChar(100) @map("ProductionVolume")
  employees        Int     @map("Employees")
  facilities       Int     @map("Facilities")
  topCustomers     String  @db.NVarChar(300) @map("TopCustomers")
  immexStatusId    Int @map("FK_ImmexStatus")
  immexStatus      ImmexStatus @relation(fields: [immexStatusId], references: [id])
  exportCapability String  @db.NVarChar(300) @map("ExportCapability")
  // Evaluation block (kept with commercial info; see README)
  strengths        String  @db.NVarChar(1000) @map("Strengths")
  weaknesses       String  @db.NVarChar(1000) @map("Weaknesses")
  observations     String  @db.NVarChar(1000) @map("Observations")
  recommendations  String  @db.NVarChar(1000) @map("Recommendations")
  priority         Int     @default(2) @map("Priority")
  primaryDriver    String  @db.NVarChar(100) @map("PrimaryDriver")
  confidenceLevelId Int @map("FK_ConfidenceLevel")
  confidenceLevel   ConfidenceLevel @relation(fields: [confidenceLevelId], references: [id])

  @@map("T_Supplier_CommercialInfo")
}

model SupplierDocument {
  id         Int     @id @default(autoincrement()) @map("PK_Supplier_Document")
  supplierId String  @db.NVarChar(50) @map("FK_Supplier")
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  name       String  @db.NVarChar(100) @map("Name")
  status     String  @db.NVarChar(20) @map("Status") // Firmado | Pendiente | No aplica
  date       String? @db.NVarChar(30) @map("Date")
  link       String? @db.NVarChar(500) @map("Link")

  @@index([supplierId], map: "IX_SupplierDocument_Supplier")
  @@map("T_Supplier_Document")
}

model SupplierNote {
  id         String   @id @db.NVarChar(80) @map("PK_Supplier_Note")
  supplierId String   @db.NVarChar(50) @map("FK_Supplier")
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  text       String   @db.NVarChar(2000) @map("Text")
  author     String   @db.NVarChar(100) @map("Author")
  role       String   @db.NVarChar(50) @map("Role")
  date       String   @db.NVarChar(30) @map("Date")
  stageId    Int @map("FK_Stage")
  stage      Stage @relation(fields: [stageId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  createdAt  DateTime @default(now()) @map("CreatedDt")

  @@index([supplierId], map: "IX_SupplierNote_Supplier")
  @@map("T_Supplier_Note")
}

model SupplierHistoryEntry {
  id         Int      @id @default(autoincrement()) @map("PK_Supplier_History")
  supplierId String   @db.NVarChar(50) @map("FK_Supplier")
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  date       String   @db.NVarChar(30) @map("Date")
  action     String   @db.NVarChar(500) @map("Action")
  user       String   @db.NVarChar(100) @map("User")
  role       String   @db.NVarChar(50) @map("Role")
  note       String?  @db.NVarChar(500) @map("Note")
  createdAt  DateTime @default(now()) @map("CreatedDt")

  @@index([supplierId], map: "IX_SupplierHistory_Supplier")
  @@map("T_Supplier_History")
}

// PartEvaluation (top-level `parts` array on the supplier)
model SupplierPart {
  id              Int    @id @default(autoincrement()) @map("PK_Supplier_Part")
  supplierId      String @db.NVarChar(50) @map("FK_Supplier")
  supplier        Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  partNumber      String @db.NVarChar(100) @map("PartNumber")
  partDescription String @db.NVarChar(300) @map("PartDescription")
  pl              String @db.NVarChar(50) @map("Pl")
  peakVolume      Int    @map("PeakVolume")
  program         String @db.NVarChar(100) @map("Program")
  eop             String @db.NVarChar(20) @map("Eop")
  targetPrice     Float  @map("TargetPrice")
  rfqPrice        Float  @map("RfqPrice")
  confidenceLevelId Int @map("FK_ConfidenceLevel")
  confidenceLevel   ConfidenceLevel @relation(fields: [confidenceLevelId], references: [id])

  @@index([supplierId], map: "IX_SupplierPart_Supplier")
  @@map("T_Supplier_Part")
}

// prelim_parts (Supplier Evaluation — Competitiveness tab)
model PrelimPart {
  id              Int     @id @default(autoincrement()) @map("PK_Supplier_PrelimPart")
  supplierId      String  @db.NVarChar(50) @map("FK_Supplier")
  supplier        Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  partNumber      String  @db.NVarChar(100) @map("PartNumber")
  partDescription String  @db.NVarChar(300) @map("PartDescription")
  pl              String  @db.NVarChar(50) @map("Pl")
  annualPeakVolume Int?   @map("AnnualPeakVolume")
  program         String  @db.NVarChar(100) @map("Program")
  eop             String  @db.NVarChar(20) @map("Eop")
  initialQuote    Float?  @map("InitialQuote")
  qadPrice        Float?  @map("QadPrice")
  delta           Float?  @map("Delta")
  tooling         Float?  @map("Tooling")
  savingExpected  Float?  @map("SavingExpected")
  confidenceLevelId Int? @map("FK_ConfidenceLevel")
  confidenceLevel   ConfidenceLevel? @relation(fields: [confidenceLevelId], references: [id])

  @@index([supplierId], map: "IX_PrelimPart_Supplier")
  @@map("T_Supplier_PrelimPart")
}

// ═══════════════════════════════════════════════════════════════════════
// Domain 2: Stage satellites (1:1 with Supplier — row exists once the
// supplier has reached / been created in that stage)
// ═══════════════════════════════════════════════════════════════════════

model ScoutingData {
  supplierId     String  @id @db.NVarChar(50) @map("FK_Supplier")
  supplier       Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  // scoutingTabsCompleted
  tabScoutingEvent Boolean @default(false) @map("TabScoutingEvent")
  tabSupplierInfo  Boolean @default(false) @map("TabSupplierInfo")
  tabAttendees     Boolean @default(false) @map("TabAttendees")
  tabAgenda        Boolean @default(false) @map("TabAgenda")
  tabNextStep      Boolean @default(false) @map("TabNextStep")
  // Attendees tab
  b2bStatus     String? @db.NVarChar(5) @map("B2bStatus") // Yes | No
  b2bWhoAttends String? @db.NVarChar(300) @map("B2bWhoAttends")
  b2bManager    String? @db.NVarChar(100) @map("B2bManager")
  b2bBuyer      String? @db.NVarChar(100) @map("B2bBuyer")
  b2bComments   String? @db.NVarChar(1000) @map("B2bComments")
  // Agenda tab
  agendaStatus        String? @db.NVarChar(50) @map("AgendaStatus")
  agendaTeamsLink     String? @db.NVarChar(500) @map("AgendaTeamsLink")
  agendaScheduledDate String? @db.NVarChar(30) @map("AgendaScheduledDate")
  agendaTimezone      String? @db.NVarChar(20) @map("AgendaTimezone")
  agendaStand         String? @db.NVarChar(50) @map("AgendaStand")
  agendaStartTime     String? @db.NVarChar(20) @map("AgendaStartTime")
  agendaEndTime       String? @db.NVarChar(20) @map("AgendaEndTime")
  agendaDuration      String? @db.NVarChar(20) @map("AgendaDuration")
  // Next Step tab
  selectedForParking Boolean? @map("SelectedForParking")
  selectionReason    String?  @db.NVarChar(1000) @map("SelectionReason")

  @@map("T_Supplier_ScoutingData")
}

model ParkingData {
  supplierId String  @id @db.NVarChar(50) @map("FK_Supplier")
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  onboardingDate         String?  @db.NVarChar(30) @map("OnboardingDate")
  timeless               Boolean  @default(false) @map("Timeless")
  dateToMovePreliminary  String?  @db.NVarChar(30) @map("DateToMovePreliminary")
  daysElapsed            Int?     @map("DaysElapsed")
  scoutingInput          String?  @db.NVarChar(200) @map("ScoutingInput")
  subStatusId            Int? @map("FK_SubStatus")
  subStatus              SubStatus? @relation(fields: [subStatusId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  isRecommendation       Boolean  @default(false) @map("IsRecommendation")
  buyer                  String?  @db.NVarChar(100) @map("Buyer")
  companyName            String?  @db.NVarChar(200) @map("CompanyName")
  b2bMeeting             String?  @db.NVarChar(5) @map("B2bMeeting") // Yes | No
  name1                  String?  @db.NVarChar(100) @map("Name1")
  website                String?  @db.NVarChar(300) @map("Website")
  email1                 String?  @db.NVarChar(200) @map("Email1")
  phone                  String?  @db.NVarChar(50) @map("Phone")
  commodity              String?  @db.NVarChar(100) @map("Commodity")
  productType            String?  @db.NVarChar(200) @map("ProductType")
  manufacturingCountry   String?  @db.NVarChar(100) @map("ManufacturingCountry")
  manufacturingAddress   String?  @db.NVarChar(300) @map("ManufacturingAddress")
  additionalComments     String?  @db.NVarChar(2000) @map("AdditionalComments")
  // parkingTabsCompleted — hasTabs=false ⇒ frontend receives null
  hasTabs     Boolean @default(false) @map("HasTabs")
  tabOverview Boolean @default(false) @map("TabOverview")
  tabContact  Boolean @default(false) @map("TabContact")
  tabDetails  Boolean @default(false) @map("TabDetails")

  @@map("T_Supplier_ParkingData")
}

model PreliminaryData {
  supplierId String  @id @db.NVarChar(50) @map("FK_Supplier")
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  // preliminaryTabsCompleted — hasTabs=false ⇒ null on the wire
  hasTabs         Boolean @default(false) @map("HasTabs")
  tabOverview     Boolean @default(false) @map("TabOverview")
  tabCapabilities Boolean @default(false) @map("TabCapabilities")
  tabVisit        Boolean @default(false) @map("TabVisit")

  // Overview tab
  startDate            String? @db.NVarChar(30) @map("StartDate")
  priority             Int?    @map("Priority")
  scoutingInput        String? @db.NVarChar(200) @map("ScoutingInput")
  buyer                String? @db.NVarChar(100) @map("Buyer")
  commodity            String? @db.NVarChar(100) @map("Commodity")
  primaryDriver        String? @db.NVarChar(100) @map("PrimaryDriver")
  companyName          String? @db.NVarChar(300) @map("CompanyName")
  dunsNumber           String? @db.NVarChar(50) @map("DunsNumber")
  hqAddress            String? @db.NVarChar(300) @map("HqAddress")
  hqCity               String? @db.NVarChar(100) @map("HqCity")
  hqCountry            String? @db.NVarChar(100) @map("HqCountry")
  manufacturingAddress String? @db.NVarChar(300) @map("ManufacturingAddress")
  manufacturingCity    String? @db.NVarChar(100) @map("ManufacturingCity")
  manufacturingCountry String? @db.NVarChar(100) @map("ManufacturingCountry")
  companyType          String? @db.NVarChar(50) @map("CompanyType")
  foundedYear          Int?    @map("FoundedYear")
  footprint            String? @db.NVarChar(100) @map("Footprint")
  yearsInMexico        Int?    @map("YearsInMexico")
  facilities           Int?    @map("Facilities")
  employees            Int?    @map("Employees")
  annualRevenue        String? @db.NVarChar(50) @map("AnnualRevenue")
  productionVolume     String? @db.NVarChar(100) @map("ProductionVolume")
  mainTechnology       String? @db.NVarChar(200) @map("MainTechnology")
  pressCapacity        String? @db.NVarChar(100) @map("PressCapacity")
  generalManager       String? @db.NVarChar(100) @map("GeneralManager")
  market               String? @db.NVarChar(100) @map("Market")
  topCustomers         String? @db.NVarChar(300) @map("TopCustomers")
  exportCapability     String? @db.NVarChar(300) @map("ExportCapability")
  certifications       String? @db.NVarChar(300) @map("Certifications")
  immexStatusId        Int? @map("FK_ImmexStatus")
  immexStatus          ImmexStatus? @relation(fields: [immexStatusId], references: [id])
  planToGetIMMEX       String? @db.NVarChar(5) @map("PlanToGetIMMEX")  // Y | N

  // Capabilities tab
  machineryType    String? @db.NVarChar(200) @map("MachineryType")
  processingMethod String? @db.NVarChar(200) @map("ProcessingMethod")
  complementaryOps String? @db.NVarChar(300) @map("ComplementaryOps")
  toolingDesign    String? @db.NVarChar(100) @map("ToolingDesign")
  materials        String? @db.NVarChar(300) @map("Materials")
  rawMaterialIndex String? @db.NVarChar(200) @map("RawMaterialIndex")
  applications     String? @db.NVarChar(300) @map("Applications")

  // Visit tab
  visitDatePlanned   String? @db.NVarChar(30) @map("VisitDatePlanned")
  visitDateCompleted String? @db.NVarChar(30) @map("VisitDateCompleted")
  visitParticipants  String? @db.NVarChar(300) @map("VisitParticipants")
  strengths          String? @db.NVarChar(1000) @map("Strengths")
  weaknesses         String? @db.NVarChar(1000) @map("Weaknesses")
  observations       String? @db.NVarChar(1000) @map("Observations")
  recommendations    String? @db.NVarChar(1000) @map("Recommendations")

  @@map("T_Supplier_PreliminaryData")
}

model SupplierEvalData {
  supplierId String  @id @db.NVarChar(50) @map("FK_Supplier")
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  // supplierEvalTabsCompleted — hasTabs=false ⇒ null on the wire
  hasTabs            Boolean @default(false) @map("HasTabs")
  tabCompetitiveness Boolean @default(false) @map("TabCompetitiveness")
  tabFundamentals    Boolean @default(false) @map("TabFundamentals")

  // Fundamentals tab (prelim_*Signed fields in the frontend type)
  rfqReceived String? @db.NVarChar(5) @map("RfqReceived") // Y | N
  ndaSigned   String? @db.NVarChar(5) @map("NdaSigned")
  tcsSigned   String? @db.NVarChar(5) @map("TcsSigned")
  ttcsSigned  String? @db.NVarChar(5) @map("TtcsSigned")
  nsrSigned   String? @db.NVarChar(5) @map("NsrSigned")
  sdaSigned   String? @db.NVarChar(5) @map("SdaSigned")

  @@map("T_Supplier_EvaluationData")
}

model IntelexData {
  supplierId String  @id @db.NVarChar(50) @map("FK_Supplier")
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  // intelexTabsCompleted — hasTabs=false ⇒ null on the wire
  hasTabs       Boolean @default(false) @map("HasTabs")
  tabRecord     Boolean @default(false) @map("TabRecord")
  tabTimeline   Boolean @default(false) @map("TabTimeline")
  tabEfficiency Boolean @default(false) @map("TabEfficiency")
  saved         Boolean @default(false) @map("Saved")

  recordCreationDate      String? @db.NVarChar(30) @map("RecordCreationDate")
  investigateRecordNumber String? @db.NVarChar(100) @map("InvestigateRecordNumber")

  investigateExpected String? @db.NVarChar(30) @map("InvestigateExpected")
  investigateReal     String? @db.NVarChar(30) @map("InvestigateReal")
  l0Expected          String? @db.NVarChar(30) @map("L0Expected")
  l0Real              String? @db.NVarChar(30) @map("L0Real")
  l1Expected          String? @db.NVarChar(30) @map("L1Expected")
  l1Real              String? @db.NVarChar(30) @map("L1Real")
  l2Expected          String? @db.NVarChar(30) @map("L2Expected")
  l2Real              String? @db.NVarChar(30) @map("L2Real")
  l3Expected          String? @db.NVarChar(30) @map("L3Expected")
  l3Real              String? @db.NVarChar(30) @map("L3Real")
  l4Expected          String? @db.NVarChar(30) @map("L4Expected")
  l4Real              String? @db.NVarChar(30) @map("L4Real")

  efficiencyL0 Float? @map("EfficiencyL0")
  efficiencyL1 Float? @map("EfficiencyL1")
  efficiencyL2 Float? @map("EfficiencyL2")
  efficiencyL3 Float? @map("EfficiencyL3")
  efficiencyL4 Float? @map("EfficiencyL4")

  @@map("T_Supplier_IntelexData")
}

// ═══════════════════════════════════════════════════════════════════════
// Domain 3: Exit branches
// ═══════════════════════════════════════════════════════════════════════

model BlacklistEntry {
  supplierId      String   @id @db.NVarChar(50) @map("FK_Supplier")
  supplier        Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  rejectedBy      String   @db.NVarChar(100) @map("RejectedBy")
  rejectionDate   String   @db.NVarChar(30) @map("RejectionDate")
  rejectionReason String   @db.NVarChar(2000) @map("RejectionReason")
  createdAt       DateTime @default(now()) @map("CreatedDt")

  @@map("T_Supplier_Blacklist")
}

model CompletionEntry {
  supplierId    String   @id @db.NVarChar(50) @map("FK_Supplier")
  supplier      Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  completedDate String   @db.NVarChar(30) @map("CompletedDate")
  completedBy   String   @db.NVarChar(100) @map("CompletedBy")
  createdAt     DateTime @default(now()) @map("CreatedDt")

  @@map("T_Supplier_Completion")
}

// ═══════════════════════════════════════════════════════════════════════
// Domain 4: Events
// ═══════════════════════════════════════════════════════════════════════

model Event {
  id           String  @id @db.NVarChar(50) @map("PK_Event")
  name         String  @db.NVarChar(300) @map("Name")
  dateStart    String  @db.NVarChar(30) @map("DateStart")
  dateEnd      String  @db.NVarChar(30) @map("DateEnd")
  location     String  @db.NVarChar(200) @map("Location")
  organizer    String  @db.NVarChar(100) @map("Organizer")
  contactName  String? @db.NVarChar(100) @map("ContactName")
  contactEmail String? @db.NVarChar(200) @map("ContactEmail")
  contactPhone String? @db.NVarChar(50) @map("ContactPhone")
  status       String  @db.NVarChar(20) @map("Status") // Upcoming | Ongoing | Completed
  description  String  @db.NVarChar(2000) @map("Description")
  productCategoryId Int @map("FK_ProductCategory")
  productCategory   ProductCategory @relation(fields: [productCategoryId], references: [id])
  objective    String  @db.NVarChar(2000) @map("Objective")
  topCommodity String  @db.NVarChar(100) @map("TopCommodity")
  topCountry   String  @db.NVarChar(100) @map("TopCountry")

  supplierEntries EventSupplierEntry[]
  b2bMeetings     EventB2BMeeting[]
  notes           EventNote[]

  @@index([dateStart, dateEnd], map: "IX_Event_DateRange")
  @@map("T_Event")
}

// N:M junction — suppliers per event
model EventSupplierEntry {
  id         Int      @id @default(autoincrement()) @map("PK_Event_SupplierEntry")
  eventId    String   @db.NVarChar(50) @map("FK_Event")
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  supplierId String   @db.NVarChar(50) @map("FK_Supplier")
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  b2bMeeting Boolean  @default(false) @map("B2bMeeting")
  status     String   @db.NVarChar(20) @map("Status") // Accepted | Rejected | Cancelled
  result     String   @db.NVarChar(20) @map("Result") // Included | Not Included

  @@unique([eventId, supplierId])
  @@index([supplierId], map: "IX_EventSupplierEntry_Supplier")
  @@map("T_Event_SupplierEntry")
}

model EventB2BMeeting {
  id              Int      @id @default(autoincrement()) @map("PK_Event_B2BMeeting")
  eventId         String   @db.NVarChar(50) @map("FK_Event")
  event           Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  supplierId      String?  @db.NVarChar(50) @map("FK_Supplier")
  supplier        Supplier? @relation(fields: [supplierId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  time            String   @db.NVarChar(30) @map("Time")
  stand           String   @db.NVarChar(50) @map("Stand")
  companyName     String   @db.NVarChar(200) @map("CompanyName")
  commodity       String   @db.NVarChar(100) @map("Commodity")
  attendeeManager String   @db.NVarChar(100) @map("AttendeeManager")
  attendeeBuyer   String   @db.NVarChar(100) @map("AttendeeBuyer")
  duration        String   @db.NVarChar(20) @map("Duration")
  status          String   @db.NVarChar(20) @map("Status")

  @@index([supplierId], map: "IX_EventB2BMeeting_Supplier")
  @@map("T_Event_B2BMeeting")
}

model EventNote {
  id        String   @id @db.NVarChar(80) @map("PK_Event_Note")
  eventId   String   @db.NVarChar(50) @map("FK_Event")
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  text      String   @db.NVarChar(2000) @map("Text")
  author    String   @db.NVarChar(100) @map("Author")
  role      String   @db.NVarChar(50) @map("Role")
  date      String   @db.NVarChar(30) @map("Date")
  createdAt DateTime @default(now()) @map("CreatedDt")

  @@map("T_Event_Note")
}

// ═══════════════════════════════════════════════════════════════════════
// Domain 5: Strategy / MRL
// ═══════════════════════════════════════════════════════════════════════

model StrategyEntry {
  id          String    @id @db.NVarChar(50) @map("PK_Strategy_Entry")
  commodityId Int       @unique @map("FK_Commodity")
  commodity   Commodity @relation(fields: [commodityId], references: [id])
  needs2026   Int       @map("Needs2026")
  needs2027   Int?      @map("Needs2027")
  needs2028   Int?      @map("Needs2028")
  needs2029   Int?      @map("Needs2029")
  needs2030   Int?      @map("Needs2030")
  needs2031   Int?      @map("Needs2031")
  createdBy   String    @db.NVarChar(100) @map("CreatedBy")
  // NOTE: this `updatedAt` is a String business-data field mirroring the
  // frontend contract (StrategyEntry.updatedAt), not a real DateTime audit
  // column — it does NOT get the Dt-suffix treatment (see backend/README.md).
  updatedAt   String    @db.NVarChar(30) @map("UpdatedAt")

  @@map("T_Strategy_Entry")
}

model MrlRequirement {
  id                 String    @id @db.NVarChar(50) @map("PK_Strategy_MrlRequirement")
  buyerName          String    @db.NVarChar(100) @map("BuyerName")
  commodityId        Int       @map("FK_Commodity")
  commodity          Commodity @relation(fields: [commodityId], references: [id])
  nexteerProductLine String    @db.NVarChar(50) @map("NexteerProductLine")
  vol2026            Int?      @map("Vol2026")
  vol2027            Int?      @map("Vol2027")
  vol2028            Int?      @map("Vol2028")
  vol2029            Int?      @map("Vol2029")
  vol2030            Int?      @map("Vol2030")
  vol2031            Int?      @map("Vol2031")
  partNumber         String    @db.NVarChar(100) @map("PartNumber")
  partDescription    String    @db.NVarChar(300) @map("PartDescription")
  mainMaterialsSpecTech String @db.NVarChar(500) @map("MainMaterialsSpecTech")
  peakVolume         Int?      @map("PeakVolume")
  program            String    @db.NVarChar(100) @map("Program")
  eop                String    @db.NVarChar(20) @map("Eop")
  targetPrice        Float?    @map("TargetPrice")
  priority           Int       @map("Priority")
  primaryDriver      String    @db.NVarChar(100) @map("PrimaryDriver")
  keyManufacturingCapabilities String @db.NVarChar(500) @map("KeyManufacturingCapabilities")
  safetyCriticalPart Boolean   @default(false) @map("SafetyCriticalPart")
  supplierExperienceInSafetyRequired Boolean @default(false) @map("SupplierExperienceInSafetyRequired")
  certifications     String    @db.NVarChar(300) @map("Certifications")
  knowsCQIs          Boolean   @default(false) @map("KnowsCQIs")

  @@map("T_Strategy_MrlRequirement")
}

// ═══════════════════════════════════════════════════════════════════════
// Domain 6: System — users & notifications
// ═══════════════════════════════════════════════════════════════════════

model User {
  id          String    @id @default(cuid()) @db.NVarChar(50) @map("PK_User")
  username    String    @unique @db.NVarChar(100) @map("Username")
  displayName String    @db.NVarChar(100) @map("DisplayName")
  email       String?   @db.NVarChar(200) @map("Email")
  // Active Directory objectGUID — populated on first LDAP login
  adObjectId  String?   @unique @db.NVarChar(100) @map("AdObjectId")
  // Application role — FK to C_Role (default role assignment resolved in the
  // service layer; an FK can't carry a text default like "Buyer").
  roleId      Int @map("FK_Role")
  role        Role @relation(fields: [roleId], references: [id])
  createdAt   DateTime  @default(now()) @map("CreatedDt")
  lastLoginAt DateTime? @map("LastLoginDt")

  refreshTokens RefreshToken[]
  notifications Notification[]

  @@map("C_User")
}

model RefreshToken {
  id        String    @id @default(cuid()) @db.NVarChar(50) @map("PK_User_RefreshToken")
  tokenHash String    @unique @db.NVarChar(128) @map("TokenHash")
  userId    String    @db.NVarChar(50) @map("FK_User")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime  @map("ExpiresDt")
  revokedAt DateTime? @map("RevokedDt")
  createdAt DateTime  @default(now()) @map("CreatedDt")

  @@index([expiresAt], map: "IX_RefreshToken_ExpiresAt")
  @@map("T_User_RefreshToken")
}

model Notification {
  id        String   @id @db.NVarChar(50) @map("PK_User_Notification")
  message   String   @db.NVarChar(500) @map("Message")
  type      String   @db.NVarChar(20) @map("Type") // error | warning | info
  read      Boolean  @default(false) @map("Read")
  link      String?  @db.NVarChar(300) @map("Link")
  userId    String   @db.NVarChar(50) @map("FK_User")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Frontend displays a relative label ('hace 1h') — computed from createdAt
  createdAt DateTime @default(now()) @map("CreatedDt")

  @@index([userId, read], map: "IX_Notification_User_Read")
  @@map("T_User_Notification")
}

// ═══════════════════════════════════════════════════════════════════════
// Domain 7: Catalog tables (naming-compliance retrofit) + RASIC scaffold.
// All catalogs carry the standard 4 audit columns; the RASIC assignment is a
// transactional table (no audit columns) and is intentionally left unseeded
// until the SSD team confirms the matrix.
// ═══════════════════════════════════════════════════════════════════════

model Stage {
  id        Int       @id @default(autoincrement()) @map("PK_Stage")
  name      String    @unique @db.NVarChar(50) @map("Name")
  sortOrder Int       @map("SortOrder")
  createdBy String    @db.NVarChar(100) @map("CreatedBy")
  createdAt DateTime  @default(now()) @map("CreatedDt")
  updatedBy String?   @db.NVarChar(100) @map("UpdatedBy")
  updatedAt DateTime? @map("UpdatedDt")

  suppliers        Supplier[]
  supplierNotes    SupplierNote[]
  rasicAssignments RoleRasicAssignment[]

  @@map("C_Stage")
}

model SupplierStatus {
  id        Int       @id @default(autoincrement()) @map("PK_SupplierStatus")
  name      String    @unique @db.NVarChar(20) @map("Name")
  createdBy String    @db.NVarChar(100) @map("CreatedBy")
  createdAt DateTime  @default(now()) @map("CreatedDt")
  updatedBy String?   @db.NVarChar(100) @map("UpdatedBy")
  updatedAt DateTime? @map("UpdatedDt")

  suppliers Supplier[]

  @@map("C_SupplierStatus")
}

model SubStatus {
  id        Int       @id @default(autoincrement()) @map("PK_SubStatus")
  name      String    @unique @db.NVarChar(30) @map("Name")
  createdBy String    @db.NVarChar(100) @map("CreatedBy")
  createdAt DateTime  @default(now()) @map("CreatedDt")
  updatedBy String?   @db.NVarChar(100) @map("UpdatedBy")
  updatedAt DateTime? @map("UpdatedDt")

  suppliers   Supplier[]
  parkingRows ParkingData[]

  @@map("C_SubStatus")
}

model Sla {
  id        Int       @id @default(autoincrement()) @map("PK_Sla")
  name      String    @unique @db.NVarChar(10) @map("Name")
  colorHex  String?   @db.NVarChar(7) @map("ColorHex")
  createdBy String    @db.NVarChar(100) @map("CreatedBy")
  createdAt DateTime  @default(now()) @map("CreatedDt")
  updatedBy String?   @db.NVarChar(100) @map("UpdatedBy")
  updatedAt DateTime? @map("UpdatedDt")

  suppliersBySla       Supplier[] @relation("SupplierSla")
  suppliersByGlobalSla Supplier[] @relation("SupplierGlobalSla")

  @@map("C_Sla")
}

model ProductCategory {
  id        Int       @id @default(autoincrement()) @map("PK_ProductCategory")
  name      String    @unique @db.NVarChar(10) @map("Name")
  createdBy String    @db.NVarChar(100) @map("CreatedBy")
  createdAt DateTime  @default(now()) @map("CreatedDt")
  updatedBy String?   @db.NVarChar(100) @map("UpdatedBy")
  updatedAt DateTime? @map("UpdatedDt")

  suppliers Supplier[]
  events    Event[]

  @@map("C_ProductCategory")
}

model ConfidenceLevel {
  id        Int       @id @default(autoincrement()) @map("PK_ConfidenceLevel")
  code      String    @unique @db.NVarChar(3) @map("Code")
  label     String    @unique @db.NVarChar(20) @map("Label")
  sortOrder Int       @map("SortOrder")
  createdBy String    @db.NVarChar(100) @map("CreatedBy")
  createdAt DateTime  @default(now()) @map("CreatedDt")
  updatedBy String?   @db.NVarChar(100) @map("UpdatedBy")
  updatedAt DateTime? @map("UpdatedDt")

  commercialInfos CommercialInfo[]
  supplierParts   SupplierPart[]
  prelimParts     PrelimPart[]

  @@map("C_ConfidenceLevel")
}

model ImmexStatus {
  id        Int       @id @default(autoincrement()) @map("PK_ImmexStatus")
  name      String    @unique @db.NVarChar(20) @map("Name")
  createdBy String    @db.NVarChar(100) @map("CreatedBy")
  createdAt DateTime  @default(now()) @map("CreatedDt")
  updatedBy String?   @db.NVarChar(100) @map("UpdatedBy")
  updatedAt DateTime? @map("UpdatedDt")

  commercialInfos CommercialInfo[]
  preliminaryRows PreliminaryData[]

  @@map("C_ImmexStatus")
}

model Role {
  id        Int       @id @default(autoincrement()) @map("PK_Role")
  name      String    @unique @db.NVarChar(20) @map("Name")
  createdBy String    @db.NVarChar(100) @map("CreatedBy")
  createdAt DateTime  @default(now()) @map("CreatedDt")
  updatedBy String?   @db.NVarChar(100) @map("UpdatedBy")
  updatedAt DateTime? @map("UpdatedDt")

  users            User[]
  rasicAssignments RoleRasicAssignment[]

  @@map("C_Role")
}

model RoleRasicAssignment {
  id        Int     @id @default(autoincrement()) @map("PK_Role_RasicAssignment")
  roleId    Int     @map("FK_Role")
  role      Role    @relation(fields: [roleId], references: [id])
  stageId   Int     @map("FK_Stage")
  stage     Stage   @relation(fields: [stageId], references: [id])
  rasicType String  @db.NVarChar(1) @map("RasicType")
  notes     String? @db.NVarChar(500) @map("Notes")

  @@map("T_Role_RasicAssignment")
}
