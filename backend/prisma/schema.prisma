  b2bMeetings     EventB2BMeeting[]
  notes           EventNote[]

  @@index([dateStart, dateEnd], map: "IX_Event_DateRange")
  @@map("T_Event")
}

// N:M junction — suppliers per event
model EventSupplierEntry {
  id         Int      @id @default(autoincrement()) @map("PK_Event_SupplierEntry")
  eventId    String   @map("FK_Event") @db.NVarChar(50)
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  supplierId String   @map("FK_Supplier") @db.NVarChar(50)
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  b2bMeeting Boolean  @default(false) @map("B2bMeeting")
  status     String   @map("Status") @db.NVarChar(20) // Accepted | Rejected | Cancelled
  result     String   @map("Result") @db.NVarChar(20) // Included | Not Included

  @@unique([eventId, supplierId])
  @@index([supplierId], map: "IX_EventSupplierEntry_Supplier")
  @@map("T_Event_SupplierEntry")
}

model EventB2BMeeting {
  id              Int       @id @default(autoincrement()) @map("PK_Event_B2BMeeting")
