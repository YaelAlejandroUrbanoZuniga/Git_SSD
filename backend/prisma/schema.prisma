// SSD Pipeline Management — Prisma schema (SQL Server)
//
// NOTES ON SQL SERVER LIMITATIONS (documented in README):
//  - Prisma does not support `enum` on the sqlserver provider → controlled
//    vocabularies (stage, role, sub-status, commodity…) are NVarChar columns
//    validated in the service layer (src/domain/constants.ts).
//  - Prisma does not support `Json` on sqlserver → tab-completion objects and
//    volume-by-year maps are flattened into scalar columns.
//  - Date-like display fields coming from the frontend contract are stored as
//    strings (some carry non-date values such as '2031' or 'hace 1h'); only
//    system timestamps use DateTime.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════════════════
// Domain 5 (lookup first so FKs can reference it): Commodity catalog
// ═══════════════════════════════════════════════════════════════════════

model Commodity {
  id              Int              @id @default(autoincrement())
  name            String           @unique @db.NVarChar(100)
  suppliers       Supplier[]
  strategyEntries StrategyEntry[]
  mrlRequirements MrlRequirement[]
}

// ═══════════════════════════════════════════════════════════════════════
// Domain 1: Supplier core
// ═══════════════════════════════════════════════════════════════════════

model Supplier {
  id     String @id @db.NVarChar(50)
  folio  String @unique @db.NVarChar(50)
  name   String @db.NVarChar(200)

  // Lifecycle: ACTIVE (in pipeline) | BLACKLISTED | COMPLETED
  status String @default("ACTIVE") @db.NVarChar(20)
  // PipelineStage — for BLACKLISTED rows this is the stage at rejection time
  stage  String @db.NVarChar(50)

  scoutingPhase   String? @db.NVarChar(20) // Identified | B2B
  entrySource     String  @db.NVarChar(30) // Scouting Event | Recommendation
  commodityId     Int
  commodity       Commodity @relation(fields: [commodityId], references: [id])
  productCategory String  @db.NVarChar(10) // Direct | Indirect
  productType     String  @db.NVarChar(200)
  country         String  @db.NVarChar(100)
  manufacturingAddress String @db.NVarChar(300)
  buyer           String  @db.NVarChar(100)
  scoutingInput   String  @db.NVarChar(200)

  daysInStage         Int     @default(0)
  daysSinceParkingLot Int?
  docsPercent         Int     @default(0)
  sla                 String  @default("green") @db.NVarChar(10)
  globalSla           String? @db.NVarChar(10)
  subStatus           String? @db.NVarChar(30)
  onboardingDate      String  @db.NVarChar(30)

  // Cross-stage evaluation summary (top-level fields in the frontend type)
  preEvalStartDate        String? @db.NVarChar(30)
  initialQuoteSubmitted   Boolean @default(false)
  qadPrice                String? @db.NVarChar(50)
  savingExpected          String? @db.NVarChar(50)
  tooling                 String? @db.NVarChar(50)
  selectedForDevelopment  Boolean @default(false)
  investigateRecordNumber String? @db.NVarChar(100)
  intelexDate             String? @db.NVarChar(30)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  companyInfo    CompanyInfo?
  technicalInfo  TechnicalInfo?
  commercialInfo CommercialInfo?
  documents      SupplierDocument[]
  notes          SupplierNote[]
  history        SupplierHistoryEntry[]
  parts          SupplierPart[]
  prelimParts    PrelimPart[]

  scoutingData     ScoutingData?
  parkingData      ParkingData?
  preliminaryData  PreliminaryData?
  supplierEvalData SupplierEvalData?
  intelexData      IntelexData?

  blacklistEntry  BlacklistEntry?
  completionEntry CompletionEntry?

  eventEntries EventSupplierEntry[]
  b2bMeetings  EventB2BMeeting[]
}

model CompanyInfo {
  supplierId      String  @id @db.NVarChar(50)
  supplier        Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  fullName        String  @db.NVarChar(300)
  dunsNumber      String  @db.NVarChar(50)
  taxIdNumber     String? @db.NVarChar(50)
  recommendedBy   String? @db.NVarChar(100)
  recommenderDept String? @db.NVarChar(100)
  companyType     String  @db.NVarChar(50)
  foundedYear     Int
  headquarters    String  @db.NVarChar(300)
  website         String  @db.NVarChar(300)
  phone           String  @db.NVarChar(50)
  contactEmail    String  @db.NVarChar(200)
  contactName     String  @db.NVarChar(100)
}

model TechnicalInfo {
  supplierId              String  @id @db.NVarChar(50)
  supplier                Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  technology              String  @db.NVarChar(200)
  machineryType           String  @db.NVarChar(200)
  processMethod           String  @db.NVarChar(200)
  pressCapacity           String  @db.NVarChar(100)
  materials               String  @db.NVarChar(300)
  complementaryOperations String? @db.NVarChar(300)
  safetyCritical          Boolean @default(false)
  safetyExperience        Boolean @default(false)
  certifications          String  @db.NVarChar(300)
  knowsCQIs               Boolean @default(false)
}

model CommercialInfo {
  supplierId       String  @id @db.NVarChar(50)
  supplier         Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  annualRevenue    String  @db.NVarChar(50)
  productionVolume String  @db.NVarChar(100)
  employees        Int
  facilities       Int
  topCustomers     String  @db.NVarChar(300)
  hasIMMEX         Boolean @default(false)
  planIMMEX        Boolean @default(false)
  exportCapability Boolean @default(false)
  // Evaluation block (kept with commercial info; see README)
  strengths        String  @db.NVarChar(1000)
  weaknesses       String  @db.NVarChar(1000)
  observations     String  @db.NVarChar(1000)
  recommendations  String  @db.NVarChar(1000)
  priority         Int     @default(2)
  primaryDriver    String  @db.NVarChar(100)
  confidenceLevel  String  @db.NVarChar(10)
}

model SupplierDocument {
  id         Int     @id @default(autoincrement())
  supplierId String  @db.NVarChar(50)
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  name       String  @db.NVarChar(100)
  status     String  @db.NVarChar(20) // Firmado | Pendiente | No aplica
  date       String? @db.NVarChar(30)
  link       String? @db.NVarChar(500)
}

model SupplierNote {
  id         String   @id @db.NVarChar(80)
  supplierId String   @db.NVarChar(50)
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  text       String   @db.NVarChar(2000)
  author     String   @db.NVarChar(100)
  role       String   @db.NVarChar(50)
  date       String   @db.NVarChar(30)
  stage      String   @db.NVarChar(50)
  createdAt  DateTime @default(now())
}

model SupplierHistoryEntry {
  id         Int      @id @default(autoincrement())
  supplierId String   @db.NVarChar(50)
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  date       String   @db.NVarChar(30)
  action     String   @db.NVarChar(500)
  user       String   @db.NVarChar(100)
  role       String   @db.NVarChar(50)
  note       String?  @db.NVarChar(500)
  createdAt  DateTime @default(now())
}

// PartEvaluation (top-level `parts` array on the supplier)
model SupplierPart {
  id              Int    @id @default(autoincrement())
  supplierId      String @db.NVarChar(50)
  supplier        Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  partNumber      String @db.NVarChar(100)
  partDescription String @db.NVarChar(300)
  pl              String @db.NVarChar(50)
  peakVolume      Int
  program         String @db.NVarChar(100)
  eop             String @db.NVarChar(20)
  targetPrice     Float
  rfqPrice        Float
  confidence      String @db.NVarChar(10) // High | Medium | Low
}

// prelim_parts (Supplier Evaluation — Competitiveness tab)
model PrelimPart {
  id              Int     @id @default(autoincrement())
  supplierId      String  @db.NVarChar(50)
  supplier        Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  partNumber      String  @db.NVarChar(100)
  partDescription String  @db.NVarChar(300)
  pl              String  @db.NVarChar(50)
  annualPeakVolume Int?
  program         String  @db.NVarChar(100)
  eop             String  @db.NVarChar(20)
  initialQuote    Float?
  qadPrice        Float?
  delta           Float?
  tooling         Float?
  savingExpected  Float?
  confidence      String? @db.NVarChar(5) // H | M | L
}

// ═══════════════════════════════════════════════════════════════════════
// Domain 2: Stage satellites (1:1 with Supplier — row exists once the
// supplier has reached / been created in that stage)
// ═══════════════════════════════════════════════════════════════════════

model ScoutingData {
  supplierId     String  @id @db.NVarChar(50)
  supplier       Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  // scoutingTabsCompleted
  tabScoutingEvent Boolean @default(false)
  tabSupplierInfo  Boolean @default(false)
  tabAttendees     Boolean @default(false)
  tabAgenda        Boolean @default(false)
  tabNextStep      Boolean @default(false)
  // Attendees tab
  b2bStatus     String? @db.NVarChar(5) // Yes | No
  b2bWhoAttends String? @db.NVarChar(300)
  b2bManager    String? @db.NVarChar(100)
  b2bBuyer      String? @db.NVarChar(100)
  b2bComments   String? @db.NVarChar(1000)
  // Agenda tab
  agendaStatus        String? @db.NVarChar(50)
  agendaTeamsLink     String? @db.NVarChar(500)
  agendaScheduledDate String? @db.NVarChar(30)
  agendaTimezone      String? @db.NVarChar(20)
  agendaStand         String? @db.NVarChar(50)
  agendaStartTime     String? @db.NVarChar(20)
  agendaEndTime       String? @db.NVarChar(20)
  agendaDuration      String? @db.NVarChar(20)
  // Next Step tab
  selectedForParking Boolean?
  selectionReason    String? @db.NVarChar(1000)
}

model ParkingData {
  supplierId String  @id @db.NVarChar(50)
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  onboardingDate         String?  @db.NVarChar(30)
  timeless               Boolean  @default(false)
  dateToMovePreliminary  String?  @db.NVarChar(30)
  daysElapsed            Int?
  scoutingInput          String?  @db.NVarChar(200)
  subStatus              String?  @db.NVarChar(30) // Go | No Go | Under Evaluation | On Hold
  isRecommendation       Boolean  @default(false)
  buyer                  String?  @db.NVarChar(100)
  companyName            String?  @db.NVarChar(200)
  b2bMeeting             String?  @db.NVarChar(5) // Yes | No
  name1                  String?  @db.NVarChar(100)
  website                String?  @db.NVarChar(300)
  email1                 String?  @db.NVarChar(200)
  phone                  String?  @db.NVarChar(50)
  commodity              String?  @db.NVarChar(100)
  productType            String?  @db.NVarChar(200)
  manufacturingCountry   String?  @db.NVarChar(100)
  manufacturingAddress   String?  @db.NVarChar(300)
  additionalComments     String?  @db.NVarChar(2000)
  // parkingTabsCompleted — hasTabs=false ⇒ frontend receives null
  hasTabs     Boolean @default(false)
  tabOverview Boolean @default(false)
  tabContact  Boolean @default(false)
  tabDetails  Boolean @default(false)
}

model PreliminaryData {
  supplierId String  @id @db.NVarChar(50)
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  // preliminaryTabsCompleted — hasTabs=false ⇒ null on the wire
  hasTabs         Boolean @default(false)
  tabOverview     Boolean @default(false)
  tabCapabilities Boolean @default(false)
  tabVisit        Boolean @default(false)

  // Overview tab
  startDate            String? @db.NVarChar(30)
  priority             Int?
  scoutingInput        String? @db.NVarChar(200)
  buyer                String? @db.NVarChar(100)
  commodity            String? @db.NVarChar(100)
  primaryDriver        String? @db.NVarChar(100)
  companyName          String? @db.NVarChar(300)
  dunsNumber           String? @db.NVarChar(50)
  hqAddress            String? @db.NVarChar(300)
  hqCity               String? @db.NVarChar(100)
  hqCountry            String? @db.NVarChar(100)
  manufacturingAddress String? @db.NVarChar(300)
  manufacturingCity    String? @db.NVarChar(100)
  manufacturingCountry String? @db.NVarChar(100)
  companyType          String? @db.NVarChar(50)
  foundedYear          Int?
  footprint            String? @db.NVarChar(100)
  yearsInMexico        Int?
  facilities           Int?
  employees            Int?
  annualRevenue        String? @db.NVarChar(50)
  productionVolume     String? @db.NVarChar(100)
  mainTechnology       String? @db.NVarChar(200)
  pressCapacity        String? @db.NVarChar(100)
  generalManager       String? @db.NVarChar(100)
  market               String? @db.NVarChar(100)
  topCustomers         String? @db.NVarChar(300)
  exportCapability     String? @db.NVarChar(20)
  certifications       String? @db.NVarChar(300)
  hasIMMEX             String? @db.NVarChar(10) // Yes | No | In Plan | TBC
  planToGetIMMEX       String? @db.NVarChar(5)  // Y | N

  // Capabilities tab
  machineryType    String? @db.NVarChar(200)
  processingMethod String? @db.NVarChar(200)
  complementaryOps String? @db.NVarChar(300)
  toolingDesign    String? @db.NVarChar(100)
  materials        String? @db.NVarChar(300)
  rawMaterialIndex String? @db.NVarChar(200)
  applications     String? @db.NVarChar(300)

  // Visit tab
  visitDatePlanned   String? @db.NVarChar(30)
  visitDateCompleted String? @db.NVarChar(30)
  visitParticipants  String? @db.NVarChar(300)
  strengths          String? @db.NVarChar(1000)
  weaknesses         String? @db.NVarChar(1000)
  observations       String? @db.NVarChar(1000)
  recommendations    String? @db.NVarChar(1000)
}

model SupplierEvalData {
  supplierId String  @id @db.NVarChar(50)
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  // supplierEvalTabsCompleted — hasTabs=false ⇒ null on the wire
  hasTabs            Boolean @default(false)
  tabCompetitiveness Boolean @default(false)
  tabFundamentals    Boolean @default(false)

  // Fundamentals tab (prelim_*Signed fields in the frontend type)
  rfqReceived String? @db.NVarChar(5) // Y | N
  ndaSigned   String? @db.NVarChar(5)
  tcsSigned   String? @db.NVarChar(5)
  ttcsSigned  String? @db.NVarChar(5)
  nsrSigned   String? @db.NVarChar(5)
  sdaSigned   String? @db.NVarChar(5)
}

model IntelexData {
  supplierId String  @id @db.NVarChar(50)
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  // intelexTabsCompleted — hasTabs=false ⇒ null on the wire
  hasTabs       Boolean @default(false)
  tabRecord     Boolean @default(false)
  tabTimeline   Boolean @default(false)
  tabEfficiency Boolean @default(false)
  saved         Boolean @default(false)

  recordCreationDate      String? @db.NVarChar(30)
  investigateRecordNumber String? @db.NVarChar(100)

  investigateExpected String? @db.NVarChar(30)
  investigateReal     String? @db.NVarChar(30)
  l0Expected          String? @db.NVarChar(30)
  l0Real              String? @db.NVarChar(30)
  l1Expected          String? @db.NVarChar(30)
  l1Real              String? @db.NVarChar(30)
  l2Expected          String? @db.NVarChar(30)
  l2Real              String? @db.NVarChar(30)
  l3Expected          String? @db.NVarChar(30)
  l3Real              String? @db.NVarChar(30)
  l4Expected          String? @db.NVarChar(30)
  l4Real              String? @db.NVarChar(30)

  efficiencyL0 Float?
  efficiencyL1 Float?
  efficiencyL2 Float?
  efficiencyL3 Float?
  efficiencyL4 Float?
}

// ═══════════════════════════════════════════════════════════════════════
// Domain 3: Exit branches
// ═══════════════════════════════════════════════════════════════════════

model BlacklistEntry {
  supplierId      String   @id @db.NVarChar(50)
  supplier        Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  rejectedBy      String   @db.NVarChar(100)
  rejectionDate   String   @db.NVarChar(30)
  rejectionReason String   @db.NVarChar(2000)
  createdAt       DateTime @default(now())
}

model CompletionEntry {
  supplierId    String   @id @db.NVarChar(50)
  supplier      Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  completedDate String   @db.NVarChar(30)
  completedBy   String   @db.NVarChar(100)
  createdAt     DateTime @default(now())
}

// ═══════════════════════════════════════════════════════════════════════
// Domain 4: Events
// ═══════════════════════════════════════════════════════════════════════

model Event {
  id           String  @id @db.NVarChar(50)
  name         String  @db.NVarChar(300)
  dateStart    String  @db.NVarChar(30)
  dateEnd      String  @db.NVarChar(30)
  location     String  @db.NVarChar(200)
  organizer    String  @db.NVarChar(100)
  contactName  String? @db.NVarChar(100)
  contactEmail String? @db.NVarChar(200)
  contactPhone String? @db.NVarChar(50)
  status       String  @db.NVarChar(20) // Upcoming | Ongoing | Completed
  description  String  @db.NVarChar(2000)
  type         String  @db.NVarChar(10) // Direct | Indirect
  objective    String  @db.NVarChar(2000)
  topCommodity String  @db.NVarChar(100)
  topCountry   String  @db.NVarChar(100)

  supplierEntries EventSupplierEntry[]
  b2bMeetings     EventB2BMeeting[]
  notes           EventNote[]
}

// N:M junction — suppliers per event
model EventSupplierEntry {
  id         Int      @id @default(autoincrement())
  eventId    String   @db.NVarChar(50)
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  supplierId String   @db.NVarChar(50)
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  b2bMeeting Boolean  @default(false)
  status     String   @db.NVarChar(20) // Accepted | Rejected | Cancelled
  result     String   @db.NVarChar(20) // Included | Not Included

  @@unique([eventId, supplierId])
}

model EventB2BMeeting {
  id              Int      @id @default(autoincrement())
  eventId         String   @db.NVarChar(50)
  event           Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  supplierId      String?  @db.NVarChar(50)
  supplier        Supplier? @relation(fields: [supplierId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  time            String   @db.NVarChar(30)
  stand           String   @db.NVarChar(50)
  companyName     String   @db.NVarChar(200)
  commodity       String   @db.NVarChar(100)
  attendeeManager String   @db.NVarChar(100)
  attendeeBuyer   String   @db.NVarChar(100)
  duration        String   @db.NVarChar(20)
  status          String   @db.NVarChar(20)
}

model EventNote {
  id        String   @id @db.NVarChar(80)
  eventId   String   @db.NVarChar(50)
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  text      String   @db.NVarChar(2000)
  author    String   @db.NVarChar(100)
  role      String   @db.NVarChar(50)
  date      String   @db.NVarChar(30)
  createdAt DateTime @default(now())
}

// ═══════════════════════════════════════════════════════════════════════
// Domain 5: Strategy / MRL
// ═══════════════════════════════════════════════════════════════════════

model StrategyEntry {
  id          String    @id @db.NVarChar(50)
  commodityId Int       @unique
  commodity   Commodity @relation(fields: [commodityId], references: [id])
  needs2026   Int
  needs2027   Int?
  needs2028   Int?
  needs2029   Int?
  needs2030   Int?
  needs2031   Int?
  createdBy   String    @db.NVarChar(100)
  updatedAt   String    @db.NVarChar(30)
}

model MrlRequirement {
  id                 String    @id @db.NVarChar(50)
  buyerName          String    @db.NVarChar(100)
  commodityId        Int
  commodity          Commodity @relation(fields: [commodityId], references: [id])
  nexteerProductLine String    @db.NVarChar(50)
  vol2026            Int?
  vol2027            Int?
  vol2028            Int?
  vol2029            Int?
  vol2030            Int?
  vol2031            Int?
  partNumber         String    @db.NVarChar(100)
  partDescription    String    @db.NVarChar(300)
  mainMaterialsSpecTech String @db.NVarChar(500)
  peakVolume         Int?
  program            String    @db.NVarChar(100)
  eop                String    @db.NVarChar(20)
  targetPrice        Float?
  priority           Int
  primaryDriver      String    @db.NVarChar(100)
  keyManufacturingCapabilities String @db.NVarChar(500)
  safetyCriticalPart Boolean   @default(false)
  supplierExperienceInSafetyRequired Boolean @default(false)
  certifications     String    @db.NVarChar(300)
  knowsCQIs          Boolean   @default(false)
}

// ═══════════════════════════════════════════════════════════════════════
// Domain 6: System — users & notifications
// ═══════════════════════════════════════════════════════════════════════

model User {
  id          String    @id @default(cuid()) @db.NVarChar(50)
  username    String    @unique @db.NVarChar(100)
  displayName String    @db.NVarChar(100)
  email       String?   @db.NVarChar(200)
  // Active Directory objectGUID — populated on first LDAP login
  adObjectId  String?   @unique @db.NVarChar(100)
  // Application role — custom field, NOT derived from AD attributes
  appRole     String    @default("Buyer") @db.NVarChar(20) // SSD | PM | Buyer | SQD
  createdAt   DateTime  @default(now())
  lastLoginAt DateTime?

  refreshTokens RefreshToken[]
}

model RefreshToken {
  id        String    @id @default(cuid()) @db.NVarChar(50)
  tokenHash String    @unique @db.NVarChar(128)
  userId    String    @db.NVarChar(50)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
}

model Notification {
  id        String   @id @db.NVarChar(50)
  message   String   @db.NVarChar(500)
  type      String   @db.NVarChar(20) // error | warning | info
  read      Boolean  @default(false)
  link      String?  @db.NVarChar(300)
  // Frontend displays a relative label ('hace 1h') — computed from createdAt
  createdAt DateTime @default(now())
}
