// ═══════════════════════════════════════════════════════════════════════
// Domain 4: Events
// ═══════════════════════════════════════════════════════════════════════

model Event {
  id                String          @id @map("PK_Event") @db.NVarChar(50)
  name              String          @map("Name") @db.NVarChar(300)
  dateStart         String          @map("DateStart") @db.NVarChar(30)
  dateEnd           String          @map("DateEnd") @db.NVarChar(30)
  location          String          @map("Location") @db.NVarChar(200)
  organizer         String          @map("Organizer") @db.NVarChar(100)
  contactName       String?         @map("ContactName") @db.NVarChar(100)
  contactEmail      String?         @map("ContactEmail") @db.NVarChar(200)
  contactPhone      String?         @map("ContactPhone") @db.NVarChar(50)
  status            String          @map("Status") @db.NVarChar(20) // Upcoming | Ongoing | Completed | Canceled
  description       String          @map("Description") @db.NVarChar(2000)
  productCategoryId Int             @map("FK_ProductCategory")
  productCategory   ProductCategory @relation(fields: [productCategoryId], references: [id])
  objective         String          @map("Objective") @db.NVarChar(2000)
  topCommodity      String          @map("TopCommodity") @db.NVarChar(100)
  topCountry        String          @map("TopCountry") @db.NVarChar(100)

