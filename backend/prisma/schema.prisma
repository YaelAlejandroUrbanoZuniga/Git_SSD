// SSD Tracker Management — Prisma schema (SQL Server)
//
// NOTES ON SQL SERVER LIMITATIONS (documented in README):
//  - Prisma does not support `enum` on the sqlserver provider → controlled
//    vocabularies (stage, role, sub-status, commodity…) are NVarChar columns
//    validated in the service layer (src/domain/constants.ts).
//  - Prisma does not support `Json` on sqlserver → tab-completion objects and
//    volume-by-year maps are flattened into scalar columns.
//  - Date-like display fields coming from the frontend contract are stored as
//    strings (some carry non-date values such as '2031' or 'hace 1h'); only
//    system timestamps use DateTime.
//
// NAMING: every model/field below carries @@map/@map to translate the
// Prisma-side (camelCase, English) names into Nexteer's real SQL Server
// naming standard (T_/C_ prefixed tables, PascalCase columns, PK_/FK_
// prefixes). Prisma Client's generated API is untouched — every field name
// used by backend/src/ stays exactly as-is; only the underlying column/table
// names change. See backend/README.md for the mapping rationale.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════════════════
// Domain 5 (lookup first so FKs can reference it): Commodity catalog
// ═══════════════════════════════════════════════════════════════════════

model Commodity {
  id              Int              @id @default(autoincrement()) @map("PK_Commodity")
  name            String           @unique @map("Name") @db.NVarChar(100)
  createdBy       String           @map("CreatedBy") @db.NVarChar(100)
  createdAt       DateTime         @default(now()) @map("CreatedDt")
  updatedBy       String?          @map("UpdatedBy") @db.NVarChar(100)
  updatedAt       DateTime?        @map("UpdatedDt")
  suppliers       Supplier[]
  strategyEntries StrategyEntry[]
  mrlRequirements MrlRequirement[]

  @@map("C_Commodity")
}

// ═══════════════════════════════════════════════════════════════════════
// Domain 1: Supplier core
// ═══════════════════════════════════════════════════════════════════════

model Supplier {
  id    String @id @map("PK_Supplier") @db.NVarChar(50)
  folio String @unique @map("Folio") @db.NVarChar(50)
  name  String @map("Name") @db.NVarChar(200)

  // Lifecycle: FK to C_SupplierStatus (ACTIVE | BLACKLISTED | COMPLETED)
  statusId        Int            @map("FK_SupplierStatus")
  status          SupplierStatus @relation(fields: [statusId], references: [id])
  // Current tracker stage — FK to C_Stage
  stageId         Int            @map("FK_Stage")
  stage           Stage          @relation(fields: [stageId], references: [id])
  // Origin stage captured only when the supplier exits to 'Blacklisted' or
  // 'Completed'; null while in any of the 5 active stages.
  stageBeforeExit String?        @map("StageBeforeExit") @db.NVarChar(50)

  scoutingPhase        String?         @map("ScoutingPhase") @db.NVarChar(20) // Identified | B2B
  entrySource          String          @map("EntrySource") @db.NVarChar(30) // Scouting Event | Recommendation
  commodityId          Int             @map("FK_Commodity")
  commodity            Commodity       @relation(fields: [commodityId], references: [id])
  productCategoryId    Int             @map("FK_ProductCategory")
  productCategory      ProductCategory @relation(fields: [productCategoryId], references: [id])
  productType          String          @map("ProductType") @db.NVarChar(200)
  country              String          @map("Country") @db.NVarChar(100)
  manufacturingAddress String          @map("ManufacturingAddress") @db.NVarChar(300)
  buyer                String          @map("Buyer") @db.NVarChar(100)
  scoutingInput        String          @map("ScoutingInput") @db.NVarChar(200)

  daysInStage         Int        @default(0) @map("DaysInStage")
  daysSinceParkingLot Int?       @map("DaysSinceParkingLot")
  docsPercent         Int        @default(0) @map("DocsPercent")
  slaId               Int        @map("FK_Sla")
  sla                 Sla        @relation("SupplierSla", fields: [slaId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  globalSlaId         Int?       @map("FK_GlobalSla")
  globalSla           Sla?       @relation("SupplierGlobalSla", fields: [globalSlaId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  subStatusId         Int?       @map("FK_SubStatus")
  subStatus           SubStatus? @relation(fields: [subStatusId], references: [id])
  onboardingDate      String     @map("OnboardingDate") @db.NVarChar(30)

  // Cross-stage evaluation summary (top-level fields in the frontend type)
  preEvalStartDate        String? @map("PreEvalStartDate") @db.NVarChar(30)
  initialQuoteSubmitted   Boolean @default(false) @map("InitialQuoteSubmitted")
  qadPrice                String? @map("QadPrice") @db.NVarChar(50)
  savingExpected          String? @map("SavingExpected") @db.NVarChar(50)
  tooling                 String? @map("Tooling") @db.NVarChar(50)
  selectedForDevelopment  Boolean @default(false) @map("SelectedForDevelopment")
  investigateRecordNumber String? @map("InvestigateRecordNumber") @db.NVarChar(100)
  intelexDate             String? @map("IntelexDate") @db.NVarChar(30)

  createdAt DateTime @default(now()) @map("CreatedDt")
  updatedAt DateTime @default(now()) @updatedAt @map("UpdatedDt")

  companyInfo    CompanyInfo?
  technicalInfo  TechnicalInfo?
  commercialInfo CommercialInfo?
  documents      SupplierDocument[]
  notes          SupplierNote[]
  history        SupplierHistoryEntry[]
  parts          SupplierPart[]
  prelimParts    PrelimPart[]

  scoutingData     ScoutingData?
  parkingData      ParkingData?
  preliminaryData  PreliminaryData?
  supplierEvalData SupplierEvalData?
  intelexData      IntelexData?

  blacklistEntry  BlacklistEntry?
  completionEntry CompletionEntry?

  eventEntries EventSupplierEntry[]
  b2bMeetings  EventB2BMeeting[]

  @@index([stageId, statusId], map: "IX_Supplier_Stage_Status")
  @@index([buyer], map: "IX_Supplier_Buyer")
  @@map("T_Supplier")
}

model CompanyInfo {
  supplierId      String   @id @map("FK_Supplier") @db.NVarChar(50)
  supplier        Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  fullName        String   @map("FullName") @db.NVarChar(300)
  dunsNumber      String   @map("DunsNumber") @db.NVarChar(50)
  taxIdNumber     String?  @map("TaxIdNumber") @db.NVarChar(50)
  recommendedBy   String?  @map("RecommendedBy") @db.NVarChar(100)
  recommenderDept String?  @map("RecommenderDept") @db.NVarChar(100)
  companyType     String   @map("CompanyType") @db.NVarChar(50)
  foundedYear     Int      @map("FoundedYear")
  headquarters    String   @map("Headquarters") @db.NVarChar(300)
  website         String   @map("Website") @db.NVarChar(300)
  phone           String   @map("Phone") @db.NVarChar(50)
  contactEmail    String   @map("ContactEmail") @db.NVarChar(200)
  contactName     String   @map("ContactName") @db.NVarChar(100)

  @@index([dunsNumber], map: "IX_CompanyInfo_DunsNumber")
  @@map("T_Supplier_CompanyInfo")
}

model TechnicalInfo {
  supplierId              String   @id @map("FK_Supplier") @db.NVarChar(50)
  supplier                Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  technology              String   @map("Technology") @db.NVarChar(200)
  machineryType           String   @map("MachineryType") @db.NVarChar(200)
  processMethod           String   @map("ProcessMethod") @db.NVarChar(200)
  pressCapacity           String   @map("PressCapacity") @db.NVarChar(100)
  materials               String   @map("Materials") @db.NVarChar(300)
  complementaryOperations String?  @map("ComplementaryOperations") @db.NVarChar(300)
  safetyCritical          Boolean  @default(false) @map("SafetyCritical")
  safetyExperience        Boolean  @default(false) @map("SafetyExperience")
  certifications          String   @map("Certifications") @db.NVarChar(300)
  knowsCQIs               Boolean  @default(false) @map("KnowsCQIs")

  @@map("T_Supplier_TechnicalInfo")
}

model CommercialInfo {
  supplierId        String          @id @map("FK_Supplier") @db.NVarChar(50)
  supplier          Supplier        @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  annualRevenue     String          @map("AnnualRevenue") @db.NVarChar(50)
  productionVolume  String          @map("ProductionVolume") @db.NVarChar(100)
  employees         Int             @map("Employees")
  facilities        Int             @map("Facilities")
  topCustomers      String          @map("TopCustomers") @db.NVarChar(300)
  immexStatusId     Int             @map("FK_ImmexStatus")
  immexStatus       ImmexStatus     @relation(fields: [immexStatusId], references: [id])
  exportCapability  String          @map("ExportCapability") @db.NVarChar(300)
  // Evaluation block (kept with commercial info; see README)
  strengths         String          @map("Strengths") @db.NVarChar(1000)
  weaknesses        String          @map("Weaknesses") @db.NVarChar(1000)
  observations      String          @map("Observations") @db.NVarChar(1000)
  recommendations   String          @map("Recommendations") @db.NVarChar(1000)
  priority          Int             @default(2) @map("Priority")
  primaryDriver     String          @map("PrimaryDriver") @db.NVarChar(100)
  confidenceLevelId Int             @map("FK_ConfidenceLevel")
  confidenceLevel   ConfidenceLevel @relation(fields: [confidenceLevelId], references: [id])

  @@map("T_Supplier_CommercialInfo")
}

model SupplierDocument {
  id         Int      @id @default(autoincrement()) @map("PK_Supplier_Document")
  supplierId String   @map("FK_Supplier") @db.NVarChar(50)
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  name       String   @map("Name") @db.NVarChar(100)
  status     String   @map("Status") @db.NVarChar(20) // Firmado | Pendiente | No aplica
  date       String?  @map("Date") @db.NVarChar(30)
  link       String?  @map("Link") @db.NVarChar(500)

  @@index([supplierId], map: "IX_SupplierDocument_Supplier")
  @@map("T_Supplier_Document")
}

model SupplierNote {
  id         String   @id @map("PK_Supplier_Note") @db.NVarChar(80)
  supplierId String   @map("FK_Supplier") @db.NVarChar(50)
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  text       String   @map("Text") @db.NVarChar(2000)
  author     String   @map("Author") @db.NVarChar(100)
  role       String   @map("Role") @db.NVarChar(50)
  date       String   @map("Date") @db.NVarChar(30)
  stageId    Int      @map("FK_Stage")
  stage      Stage    @relation(fields: [stageId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  createdAt  DateTime @default(now()) @map("CreatedDt")

  @@index([supplierId], map: "IX_SupplierNote_Supplier")
  @@map("T_Supplier_Note")
}

model SupplierHistoryEntry {
  id         Int      @id @default(autoincrement()) @map("PK_Supplier_History")
  supplierId String   @map("FK_Supplier") @db.NVarChar(50)
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  date       String   @map("Date") @db.NVarChar(30)
  action     String   @map("Action") @db.NVarChar(500)
  user       String   @map("User") @db.NVarChar(100)
  role       String   @map("Role") @db.NVarChar(50)
  note       String?  @map("Note") @db.NVarChar(500)
  createdAt  DateTime @default(now()) @map("CreatedDt")

  @@index([supplierId], map: "IX_SupplierHistory_Supplier")
  @@map("T_Supplier_History")
}

// PartEvaluation (top-level `parts` array on the supplier)
model SupplierPart {
  id                Int             @id @default(autoincrement()) @map("PK_Supplier_Part")
  supplierId        String          @map("FK_Supplier") @db.NVarChar(50)
  supplier          Supplier        @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  partNumber        String          @map("PartNumber") @db.NVarChar(100)
  partDescription   String          @map("PartDescription") @db.NVarChar(300)
  pl                String          @map("Pl") @db.NVarChar(50)
  peakVolume        Int             @map("PeakVolume")
  program           String          @map("Program") @db.NVarChar(100)
  eop               String          @map("Eop") @db.NVarChar(20)
  targetPrice       Float           @map("TargetPrice")
  rfqPrice          Float           @map("RfqPrice")
  confidenceLevelId Int             @map("FK_ConfidenceLevel")
  confidenceLevel   ConfidenceLevel @relation(fields: [confidenceLevelId], references: [id])

  @@index([supplierId], map: "IX_SupplierPart_Supplier")
  @@map("T_Supplier_Part")
}

// prelim_parts (Supplier Evaluation — Competitiveness tab)
model PrelimPart {
  id                Int              @id @default(autoincrement()) @map("PK_Supplier_PrelimPart")
  supplierId        String           @map("FK_Supplier") @db.NVarChar(50)
  supplier          Supplier         @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  partNumber        String           @map("PartNumber") @db.NVarChar(100)
  partDescription   String           @map("PartDescription") @db.NVarChar(300)
  pl                String           @map("Pl") @db.NVarChar(50)
  annualPeakVolume  Int?             @map("AnnualPeakVolume")
  program           String           @map("Program") @db.NVarChar(100)
  eop               String           @map("Eop") @db.NVarChar(20)
  initialQuote      Float?           @map("InitialQuote")
  qadPrice          Float?           @map("QadPrice")
  delta             Float?           @map("Delta")
  tooling           Float?           @map("Tooling")
  savingExpected    Float?           @map("SavingExpected")
  confidenceLevelId Int?             @map("FK_ConfidenceLevel")
  confidenceLevel   ConfidenceLevel? @relation(fields: [confidenceLevelId], references: [id])

  @@index([supplierId], map: "IX_PrelimPart_Supplier")
  @@map("T_Supplier_PrelimPart")
}

// ═══════════════════════════════════════════════════════════════════════
// Domain 2: Stage satellites (1:1 with Supplier — row exists once the
// supplier has reached / been created in that stage)
// ═══════════════════════════════════════════════════════════════════════

model ScoutingData {
  supplierId          String   @id @map("FK_Supplier") @db.NVarChar(50)
  supplier            Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  // scoutingTabsCompleted
  tabScoutingEvent    Boolean  @default(false) @map("TabScoutingEvent")
  tabSupplierInfo     Boolean  @default(false) @map("TabSupplierInfo")
  tabAttendees        Boolean  @default(false) @map("TabAttendees")
  tabAgenda           Boolean  @default(false) @map("TabAgenda")
  tabNextStep         Boolean  @default(false) @map("TabNextStep")
  // Attendees tab
  b2bStatus           String?  @map("B2bStatus") @db.NVarChar(5) // Yes | No
  b2bWhoAttends       String?  @map("B2bWhoAttends") @db.NVarChar(300)
  b2bManager          String?  @map("B2bManager") @db.NVarChar(100)
  b2bBuyer            String?  @map("B2bBuyer") @db.NVarChar(100)
  b2bComments         String?  @map("B2bComments") @db.NVarChar(1000)
  // Agenda tab
  agendaStatus        String?  @map("AgendaStatus") @db.NVarChar(50)
  agendaTeamsLink     String?  @map("AgendaTeamsLink") @db.NVarChar(500)
  agendaScheduledDate String?  @map("AgendaScheduledDate") @db.NVarChar(30)
  agendaTimezone      String?  @map("AgendaTimezone") @db.NVarChar(20)
  agendaStand         String?  @map("AgendaStand") @db.NVarChar(50)
  agendaStartTime     String?  @map("AgendaStartTime") @db.NVarChar(20)
  agendaEndTime       String?  @map("AgendaEndTime") @db.NVarChar(20)
  agendaDuration      String?  @map("AgendaDuration") @db.NVarChar(20)
  // Next Step tab
  selectedForParking  Boolean? @map("SelectedForParking")
  selectionReason     String?  @map("SelectionReason") @db.NVarChar(1000)

  @@map("T_Supplier_ScoutingData")
}

model ParkingData {
  supplierId String   @id @map("FK_Supplier") @db.NVarChar(50)
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  onboardingDate        String?    @map("OnboardingDate") @db.NVarChar(30)
  timeless              Boolean    @default(false) @map("Timeless")
  dateToMovePreliminary String?    @map("DateToMovePreliminary") @db.NVarChar(30)
  daysElapsed           Int?       @map("DaysElapsed")
  scoutingInput         String?    @map("ScoutingInput") @db.NVarChar(200)
  subStatusId           Int?       @map("FK_SubStatus")
  subStatus             SubStatus? @relation(fields: [subStatusId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  isRecommendation      Boolean    @default(false) @map("IsRecommendation")
  buyer                 String?    @map("Buyer") @db.NVarChar(100)
  companyName           String?    @map("CompanyName") @db.NVarChar(200)
  b2bMeeting            String?    @map("B2bMeeting") @db.NVarChar(5) // Yes | No
  name1                 String?    @map("Name1") @db.NVarChar(100)
  website               String?    @map("Website") @db.NVarChar(300)
  email1                String?    @map("Email1") @db.NVarChar(200)
  phone                 String?    @map("Phone") @db.NVarChar(50)
  commodity             String?    @map("Commodity") @db.NVarChar(100)
  productType           String?    @map("ProductType") @db.NVarChar(200)
  manufacturingCountry  String?    @map("ManufacturingCountry") @db.NVarChar(100)
  manufacturingAddress  String?    @map("ManufacturingAddress") @db.NVarChar(300)
  additionalComments    String?    @map("AdditionalComments") @db.NVarChar(2000)
  // parkingTabsCompleted — hasTabs=false ⇒ frontend receives null
  hasTabs               Boolean    @default(false) @map("HasTabs")
  tabOverview           Boolean    @default(false) @map("TabOverview")
  tabContact            Boolean    @default(false) @map("TabContact")
  tabDetails            Boolean    @default(false) @map("TabDetails")

  @@map("T_Supplier_ParkingData")
}

model PreliminaryData {
  supplierId String   @id @map("FK_Supplier") @db.NVarChar(50)
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  // preliminaryTabsCompleted — hasTabs=false ⇒ null on the wire
  hasTabs         Boolean @default(false) @map("HasTabs")
  tabOverview     Boolean @default(false) @map("TabOverview")
  tabCapabilities Boolean @default(false) @map("TabCapabilities")
  tabVisit        Boolean @default(false) @map("TabVisit")

  // Overview tab
  startDate            String?      @map("StartDate") @db.NVarChar(30)
  priority             Int?         @map("Priority")
  scoutingInput        String?      @map("ScoutingInput") @db.NVarChar(200)
  buyer                String?      @map("Buyer") @db.NVarChar(100)
  commodity            String?      @map("Commodity") @db.NVarChar(100)
  primaryDriver        String?      @map("PrimaryDriver") @db.NVarChar(100)
  companyName          String?      @map("CompanyName") @db.NVarChar(300)
  dunsNumber           String?      @map("DunsNumber") @db.NVarChar(50)
  hqAddress            String?      @map("HqAddress") @db.NVarChar(300)
  hqCity               String?      @map("HqCity") @db.NVarChar(100)
  hqCountry            String?      @map("HqCountry") @db.NVarChar(100)
  manufacturingAddress String?      @map("ManufacturingAddress") @db.NVarChar(300)
  manufacturingCity    String?      @map("ManufacturingCity") @db.NVarChar(100)
  manufacturingCountry String?      @map("ManufacturingCountry") @db.NVarChar(100)
  companyType          String?      @map("CompanyType") @db.NVarChar(50)
  foundedYear          Int?         @map("FoundedYear")
  footprint            String?      @map("Footprint") @db.NVarChar(100)
  yearsInMexico        Int?         @map("YearsInMexico")
  facilities           Int?         @map("Facilities")
  employees            Int?         @map("Employees")
  annualRevenue        String?      @map("AnnualRevenue") @db.NVarChar(50)
  productionVolume     String?      @map("ProductionVolume") @db.NVarChar(100)
  mainTechnology       String?      @map("MainTechnology") @db.NVarChar(200)
  pressCapacity        String?      @map("PressCapacity") @db.NVarChar(100)
  generalManager       String?      @map("GeneralManager") @db.NVarChar(100)
  market               String?      @map("Market") @db.NVarChar(100)
  topCustomers         String?      @map("TopCustomers") @db.NVarChar(300)
  exportCapability     String?      @map("ExportCapability") @db.NVarChar(300)
  certifications       String?      @map("Certifications") @db.NVarChar(300)
  immexStatusId        Int?         @map("FK_ImmexStatus")
  immexStatus          ImmexStatus? @relation(fields: [immexStatusId], references: [id])
  planToGetIMMEX       String?      @map("PlanToGetIMMEX") @db.NVarChar(5) // Y | N

  // Capabilities tab
  machineryType    String? @map("MachineryType") @db.NVarChar(200)
  processingMethod String? @map("ProcessingMethod") @db.NVarChar(200)
  complementaryOps String? @map("ComplementaryOps") @db.NVarChar(300)
  toolingDesign    String? @map("ToolingDesign") @db.NVarChar(100)
  materials        String? @map("Materials") @db.NVarChar(300)
  rawMaterialIndex String? @map("RawMaterialIndex") @db.NVarChar(200)
  applications     String? @map("Applications") @db.NVarChar(300)

  // Visit tab
  visitDatePlanned   String? @map("VisitDatePlanned") @db.NVarChar(30)
  visitDateCompleted String? @map("VisitDateCompleted") @db.NVarChar(30)
  visitParticipants  String? @map("VisitParticipants") @db.NVarChar(300)
  strengths          String? @map("Strengths") @db.NVarChar(1000)
  weaknesses         String? @map("Weaknesses") @db.NVarChar(1000)
  observations       String? @map("Observations") @db.NVarChar(1000)
  recommendations    String? @map("Recommendations") @db.NVarChar(1000)

  @@map("T_Supplier_PreliminaryData")
}

model SupplierEvalData {
  supplierId String   @id @map("FK_Supplier") @db.NVarChar(50)
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  // supplierEvalTabsCompleted — hasTabs=false ⇒ null on the wire
  hasTabs            Boolean @default(false) @map("HasTabs")
  tabCompetitiveness Boolean @default(false) @map("TabCompetitiveness")
  tabFundamentals    Boolean @default(false) @map("TabFundamentals")

  // Fundamentals tab (prelim_*Signed fields in the frontend type)
  rfqReceived String? @map("RfqReceived") @db.NVarChar(5) // Y | N
  ndaSigned   String? @map("NdaSigned") @db.NVarChar(5)
  tcsSigned   String? @map("TcsSigned") @db.NVarChar(5)
  ttcsSigned  String? @map("TtcsSigned") @db.NVarChar(5)
  nsrSigned   String? @map("NsrSigned") @db.NVarChar(5)
  sdaSigned   String? @map("SdaSigned") @db.NVarChar(5)

  @@map("T_Supplier_EvaluationData")
}

model IntelexData {
  supplierId String   @id @map("FK_Supplier") @db.NVarChar(50)
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  // intelexTabsCompleted — hasTabs=false ⇒ null on the wire
  hasTabs       Boolean @default(false) @map("HasTabs")
  tabRecord     Boolean @default(false) @map("TabRecord")
  tabTimeline   Boolean @default(false) @map("TabTimeline")
  tabEfficiency Boolean @default(false) @map("TabEfficiency")
  saved         Boolean @default(false) @map("Saved")

  recordCreationDate      String? @map("RecordCreationDate") @db.NVarChar(30)
  investigateRecordNumber String? @map("InvestigateRecordNumber") @db.NVarChar(100)

  investigateExpected String? @map("InvestigateExpected") @db.NVarChar(30)
  investigateReal     String? @map("InvestigateReal") @db.NVarChar(30)
  l0Expected          String? @map("L0Expected") @db.NVarChar(30)
  l0Real              String? @map("L0Real") @db.NVarChar(30)
  l1Expected          String? @map("L1Expected") @db.NVarChar(30)
  l1Real              String? @map("L1Real") @db.NVarChar(30)
  l2Expected          String? @map("L2Expected") @db.NVarChar(30)
  l2Real              String? @map("L2Real") @db.NVarChar(30)
  l3Expected          String? @map("L3Expected") @db.NVarChar(30)
  l3Real              String? @map("L3Real") @db.NVarChar(30)
  l4Expected          String? @map("L4Expected") @db.NVarChar(30)
  l4Real              String? @map("L4Real") @db.NVarChar(30)

  efficiencyL0 Float? @map("EfficiencyL0")
  efficiencyL1 Float? @map("EfficiencyL1")
